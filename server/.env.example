# ======================================================
# =================[ SERVER SETTINGS ]==================
# ======================================================

PORT=8080

# ======================================================
# =================[ MONGODB DATABASE ]=================
# ======================================================

MONGODB_PORT=27017

MONGODB_USERNAME=lightning
MONGODB_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

MONGODB_URI=mongodb://$MONGODB_USERNAME:$MONGODB_PASSWORD@mongodb:$MONGODB_PORT/lightning?authSource=admin

MONGODB_HEALTHCHECK_RETRIES=10
MONGODB_HEALTHCHECK_TIMEOUT=5s
MONGODB_HEALTHCHECK_INTERVAL=10s
MONGODB_HEALTHCHECK_START_PERIOD=20s
